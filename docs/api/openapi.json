    "/v1/personas-cuidadas/{persona_id}/plan/ficha/{campo}": {
      "put": {
        "tags": [
          "ficha"
        ],
        "summary": "Guardar",
        "operationId": "guardar_v1_personas_cuidadas__persona_id__plan_ficha__campo__put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "persona_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Persona Id"
            }
          },
          {
            "name": "campo",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "rutina",
                "manejo_situaciones",
                "red_apoyo"
              ],
              "title": "Campo"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          },
          {
            "name": "X-Grupo-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Grupo-Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudCampo"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampoGuardadoVista"
                }
              }
            }
          },
          "401": {
            "description": "Falta el access token, o es inválido o vencido",
            "content": {
              "application/problem+json": {}
            }
          },
          "403": {
            "description": "Sin consentimiento vigente para plan_cuidado, o revisión anual vencida",
            "content": {
              "application/problem+json": {}
            }
          },
          "404": {
            "description": "No miembro, rol que no alcanza, persona de otro grupo o inexistente",
            "content": {
              "application/problem+json": {}
            }
          },
          "500": {
            "description": "Error inesperado o sección ilegible, sin el texto",
            "content": {
              "application/problem+json": {}
            }
          },
          "503": {
            "description": "La custodia de la clave maestra no está configurada",
            "content": {
              "application/problem+json": {}
            }
          },
          "201": {
            "description": "Campo creado: primera escritura",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CampoGuardadoVista"
                }
              }
            }
          },
          "412": {
            "description": "If-Match desactualizado o If-None-Match: * sobre un campo que ya existe. Trae `actual`",
            "content": {
              "application/problem+json": {}
            }
          },
          "422": {
            "description": "Cuerpo o cabeceras de precondición inválidos. errores[] nombra el campo, nunca el valor",
            "content": {
              "application/problem+json": {}
            }
          },
          "428": {
            "description": "Sin If-Match ni If-None-Match, o con If-Match: *",
            "content": {
              "application/problem+json": {}
            }
          }
        }
      }
