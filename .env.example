# MATU · Variables de entorno locales
# Copia este archivo como .env y cambia las contraseñas. El .env no se sube al repositorio.

# API: local, pruebas, staging o produccion, en minúsculas y tal cual (Staging, stage o prod no arrancan).
# Solo local y pruebas publican /docs y /openapi.json (decisión 115). Sin ENTORNO la API arranca como local. En Railway se define de forma
# explícita, SIEMPRE, como ENTORNO=staging (decisión 105). El arranque registra el entorno en WARNING, y
# si el log de Railway no muestra entorno=staging, el despliegue no se da por bueno.
ENTORNO=local
LOG_NIVEL=INFO

# Versión de docs/legal/politica-privacidad.md del repositorio MATU, en formato MAYOR.MENOR.
# Debe coincidir con el encabezado de ese documento. La 1.0 queda para la primera versión
# revisada por un abogado. Obligatoria salvo con ENTORNO=pruebas: sin ella la API no arranca (MATU-07).
POLITICA_VERSION=0.13

# Llave del HMAC del email en indice_credencial (MATU-04). Al menos 32 caracteres, nunca en el
# repositorio. Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
# Si cambia, los índices ya guardados dejan de servir y nadie puede iniciar sesión.
PEPPER_EMAIL=

# Clave con que se firman los access tokens, JWT HS256 de 15 minutos (MATU-05a). Al menos 32
# caracteres, nunca en el repositorio. Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
# Debe ser distinta de PEPPER_EMAIL. Si cambia, todas las sesiones abiertas se cierran.
JWT_CLAVE=

# Custodia de la clave maestra (KEK) de la ficha de relevo (MATU-12, decisión D-A del 28-10).
# Desvío explícito del ADR-016: SOLO para el semestre y SOLO con datos sintéticos.
# Se enciende con CUSTODIA_KEK=entorno_sintetico, y solo con ENTORNO=local, pruebas o staging (staging
# por la decisión 105, con una KEK propia guardada solo en Railway): con produccion la API no arranca. Encendida sin KEK_ENTORNO, tampoco. Apagada, la ficha responde 503.
CUSTODIA_KEK=
# 32 bytes aleatorios en base64, distinta de JWT_CLAVE y PEPPER_EMAIL. Nunca en el repositorio ni en
# docker-compose. Genérala con:
#   python -c "import base64, secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Si la cambias, cambia también KEK_VERSION: las fichas escritas con la anterior dejan de leerse.
KEK_ENTORNO=
KEK_VERSION=1

# Llave del HMAC del PIN del acceso de relevo (MATU-18). Al menos 32 caracteres, distinta de
# PEPPER_EMAIL, JWT_CLAVE y KEK_ENTORNO, nunca en el repositorio. Genérala con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Sin ella, compartir la ficha responde 503. Si cambia, los PIN ya entregados dejan de servir.
PEPPER_PIN=

# Llave del HMAC de las huellas de la IP y del email de la demora progresiva de la entrada (MATU-38).
# Al menos 32 caracteres, distinta de PEPPER_EMAIL, JWT_CLAVE, KEK_ENTORNO y PEPPER_PIN, nunca en el
# repositorio. Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
# Sin ella, iniciar sesión responde 503. Si cambia, los contadores de intentos vuelven a cero.
# MATU-25: también es la llave del límite por IP de POST /v1/usuarios, /v1/relevo/canje y
# /v1/relevo/presentacion, con un prefijo distinto por contador. Sin ella, esas rutas responden 503.
# En staging usa una propia, nunca la de tu .env local.
PEPPER_LIMITES=

# MATU-57: llave del HMAC de los códigos de recuperación y de verificación del celular. Distinta de
# todas las anteriores. Genérala con: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sin ella, recuperar el acceso y verificar el celular responden 503.
PEPPER_RECUPERACION=

# MATU-57: envío de los códigos. En el semestre solo "simulado" (no envía nada; deja el mensaje en
# REGISTRO_ENVIOS para probar a mano). Solo con ENTORNO local, pruebas o staging: en produccion la API no
# arranca.
ENVIADOR_CODIGOS=simulado
# Archivo del envío simulado, en una carpeta ignorada por git. Nunca es un log de la aplicación.
REGISTRO_ENVIOS=.dev/envios.jsonl

# MATU-41: envío de los avisos por correo y push. En el semestre solo "simulado" (no envía nada; deja en
# REGISTRO_AVISOS el id del aviso, la persona, el canal y la plantilla, nunca el destino ni el texto). Solo
# con ENTORNO local, pruebas o staging: en produccion la API no arranca. Vacía, no se envía ningún aviso.
ENVIADOR_AVISOS=simulado
# Archivo del envío simulado, en .dev/ (ignorada por git), nunca un log. Solo con ENTORNO local o pruebas (MATU-74).
REGISTRO_AVISOS=.dev/avisos.jsonl

# Origen https de la aplicación web, sin barra final. El enlace del relevo es <origen>/r#<token>.
ORIGEN_WEB=https://localhost

# Redis de las sesiones de relevo (MATU-19) y de los contadores de la demora de la entrada (MATU-38).
# Guarda el id del acceso bajo el SHA-256 del id de sesión, y contadores bajo huellas HMAC.
REDIS_URL=redis://127.0.0.1:6379/0

# Arranque detrás de un proxy (MATU-25, solo con python -m app.servidor, en staging).
# IP o redes CIDR, separadas por comas, desde donde conecta el proxy de la plataforma. Solo de ellas se
# acepta X-Forwarded-For. Vacía: 127.0.0.1. Nunca '*' ni 0.0.0.0/0: la API no arranca con eso.
FORWARDED_ALLOW_IPS=
# Cuántas IP propias agrega el borde de la plataforma a la derecha de X-Forwarded-For, de 0 a 5 (MATU-25,
# decisión 114). Vacía: 0, la IP de más a la derecha que no es de confianza. En Railway, 1: cuenta la IP
# que queda justo a la izquierda del borde, nunca la primera de la lista. Otro valor: la API no arranca.
PROXY_SALTOS=
# Diagnóstico temporal de X-Forwarded-For: una línea por petición del proxy con la cantidad y la clase de
# cada elemento, nunca una IP. Vacía o false: apagado. true solo con ENTORNO local, pruebas o staging; con
# produccion la API no arranca. Se enciende para verificar PROXY_SALTOS y se apaga después.
DIAGNOSTICO_PROXY=
# Puerto de la API. Railway lo fija solo; en local, 8000 por omisión.
PORT=

# Solo para infra/railway/preparar_base.sh: la URL del superusuario de la base gestionada de Railway
# (DATABASE_PUBLIC_URL del servicio Postgres). Nunca la usa la API.
ADMIN_DATABASE_URL=

# Superusuario de PostgreSQL. Solo lo usan el script de arranque y las pruebas.
POSTGRES_PASSWORD=cambia-esto

# Dueño del esquema. Solo lo usa Alembic.
MATU_OWNER_PASSWORD=cambia-esto
# Rol de la aplicación. RLS lo alcanza siempre.
MATU_APP_PASSWORD=cambia-esto

# La contraseña de cada URL debe coincidir con la de su rol, arriba.
# Usa solo letras, números y guiones para no tener que codificarlas en la URL.
# Se usa 127.0.0.1 y no localhost: en algunos Windows localhost va primero a IPv6 (::1),
# Docker publica la base en IPv4 y la conexión se queda colgada sin dar error.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://matu_owner:cambia-esto@127.0.0.1:5432/matu
DATABASE_URL=postgresql+psycopg://matu_app:cambia-esto@127.0.0.1:5432/matu
# MATU-74: las conexiones de las tareas, nunca de la API. matu_scheduler enumera los grupos y corre los borrados y la
# conservación; matu_publisher corre el outbox de los avisos. Vacías, la API funciona igual y la tarea que las
# necesita falla con un error que nombra la variable, sin usar DATABASE_URL.
SCHEDULER_DATABASE_URL=postgresql+psycopg://matu_scheduler:cambia-esto@127.0.0.1:5432/matu
PUBLISHER_DATABASE_URL=postgresql+psycopg://matu_publisher:cambia-esto@127.0.0.1:5432/matu
# Las contraseñas de esos dos roles. Solo las usan infra/postgres/init/10_matu.sh al crear el volumen e
# infra/railway/preparar_base.sh. Con un volumen anterior, fíjalas con ALTER ROLE (backend/README.md).
MATU_SCHEDULER_PASSWORD=cambia-esto
MATU_PUBLISHER_PASSWORD=cambia-esto

# Pruebas de aislamiento: se conectan como superusuario solo para sembrar datos.
# Usa la misma contraseña de POSTGRES_PASSWORD. Va entre comillas porque lleva espacios: así el
# archivo también se puede cargar con `source` (docker compose y pydantic-settings quitan las comillas).
MATU_TEST_DSN="host=127.0.0.1 port=5432 user=postgres password=cambia-esto dbname=matu"

# Capa 3, el despacho (MATU-40, ADR-002): true monta sus routers (pedido, pago, entrega). Apagada, la
# ficha, el relevo y el consumo funcionan igual. Hoy la capa 3 no tiene routers. No es un secreto.
CAPA3_HABILITADA=false

# MATU-62: la pasarela del pago. integracion es Webpay Plus en el ambiente de integración de Transbank, con las
# credenciales públicas de su SDK (no se cargan aquí). falsa aprueba sin red, solo con ENTORNO local o pruebas. Vacía,
# pagar responde 503 y no se cobra nada.
PASARELA_PAGO=
# Cuánto dura un pago en curso con la venta iniciada (decisión 230). No es un secreto.
VIDA_VENTA_WEBPAY_MINUTOS=10
# BLOQUEADO: dinero real. PASARELA_PAGO=produccion exige ENTORNO=produccion, DINERO_REAL_AUTORIZADO=true y las
# credenciales del comercio (WEBPAY_CODIGO_COMERCIO y WEBPAY_LLAVE, solo en el entorno de producción, nunca aquí).
# Queda en false hasta cerrar las consultas legales CL-54, CL-55, CL-56, CL-64, CL-65 y CL-66; sin eso, la API no arranca.
DINERO_REAL_AUTORIZADO=false

# Política de privacidad visible (MATU-75). POLITICA_VERSION, arriba, pasa a 0.13 con MATU-62: su texto está en
# backend/app/modules/iam/politica/politica-0.13.md (la 0.11 y la 0.12 siguen publicadas). Una versión sin texto publicado, o con un marcador sin
# completar, deja GET /v1/politica y crear una cuenta en 503.
# La fecha de esa versión, en AAAA-MM-DD. Se muestra «actualizada el DD/MM/AAAA».
POLITICA_ACTUALIZADA_EN=2026-11-11
# El correo de contacto de privacidad, una dirección del proyecto y nunca personal (lo dio Jorge el 09-11). El texto
# de la política ya lo trae escrito: este valor es el que GET /v1/politica entrega aparte, para el mailto: de «Tu
# cuenta», y debe ser el mismo. No es un secreto. Vacío, correo_contacto sale null.
CORREO_PRIVACIDAD=cuidaconmatu@gmail.com
