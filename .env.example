# MATU · Variables de entorno locales
# Copia este archivo como .env y cambia las contraseñas. El .env no se sube al repositorio.

# API: local, pruebas o produccion. En produccion se apaga /docs.
ENTORNO=local
LOG_NIVEL=INFO

# Versión de docs/legal/politica-privacidad.md del repositorio MATU, en formato MAYOR.MENOR.
# Debe coincidir con el encabezado de ese documento. La 1.0 queda para la primera versión
# revisada por un abogado.
POLITICA_VERSION=0.9

# Llave del HMAC del email en indice_credencial (MATU-04). Al menos 32 caracteres, nunca en el
# repositorio. Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
# Si cambia, los índices ya guardados dejan de servir y nadie puede iniciar sesión.
PEPPER_EMAIL=

# Clave con que se firman los access tokens, JWT HS256 de 15 minutos (MATU-05a). Al menos 32
# caracteres, nunca en el repositorio. Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
# Debe ser distinta de PEPPER_EMAIL. Si cambia, todas las sesiones abiertas se cierran.
JWT_CLAVE=

# Superusuario de PostgreSQL. Solo lo usan el script de arranque y las pruebas.
POSTGRES_PASSWORD=cambia-esto

# Dueño del esquema. Solo lo usa Alembic.
MATU_OWNER_PASSWORD=cambia-esto
# Rol de la aplicación. RLS lo alcanza siempre.
MATU_APP_PASSWORD=cambia-esto

# La contraseña de cada URL debe coincidir con la de su rol, arriba.
# Usa solo letras, números y guiones para no tener que codificarlas en la URL.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://matu_owner:cambia-esto@localhost:5432/matu
DATABASE_URL=postgresql+psycopg://matu_app:cambia-esto@localhost:5432/matu

# Pruebas de aislamiento: se conectan como superusuario solo para sembrar datos.
# Usa la misma contraseña de POSTGRES_PASSWORD.
MATU_TEST_DSN=host=localhost port=5432 user=postgres password=cambia-esto dbname=matu
